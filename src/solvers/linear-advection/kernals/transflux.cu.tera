// Tranforms the phsyical flux into reference space
extern "C" __global__ void transformed_interior_flux(
    const {{ fp_type }}* __restrict__ u, 
    const {{ fp_type }}* __restrict__ inv_j, 
    const {{ fp_type }}* __restrict__ det_j, 
    {{ fp_type }}* __restrict__ transformed_interior_flux, 
    int n_elements, 
) {
    int element_idx = blockIdx.x;
    int point_idx = threadIdx.x;

    if (element_idx < n_elements && point_idx < {{ n_points }}) {
        int idx = element_idx * {{ n_points }} + point_idx;
        {{ fp_type }} physical_flux[{{ ndims }}];

        // compute the physical flux 
        {% for i in range(end=ndims) %}
            physical_flux[{{ i }}] = {{ a[i] }} * u[idx];
        {% endfor %}

        {% for i in range(end=ndims) %}
            int flux_point_idx = idx * {{ ndims }} + {{ i }};
            transformed_flux[flux_point_idx] = 0.0;

            {% for j in range(end=ndims) %}
                // compute transformed flux
                transformed_flux[flux_point_idx] += 
                    inv_j[idx * {{ ndims * ndims }} + {{ i }} * {{ ndims }} + {{ j }}]
                    * physical_flux[{{ j }}];
            {% endfor %}

            // multiply by Jacobian determinant
            transformed_flux[flux_point_idx] *= det_j[idx];
        {% endfor %}
    }
}